<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 状态共享容器：uiState/主题/握持监听/偏好 的唯一持有方 -->
    <application
        android:name=".AIFreegripApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AIFreegrip">

        <!-- 主页 = launcher 入口（singleTask，避免多实例）。
             预测性返回（Predictive Back）：enableOnBackInvokedCallback 启用
             OnBackInvokedCallback 分发，返回手势跟手动画由系统提供。
             本项是普通 manifest 属性，不属于 <uses-permission>，不触碰合规红线。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AIFreegrip"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 深链 aifreegrip://page/{id}：静态 App Shortcuts 的 intent 是隐式
                 VIEW+data，必须在此可被 resolve——否则 launcher 点快捷方式报
                 「未找到应用」。外部应用可借此打开对应页面（演示无敏感数据，
                 仍不涉及任何 manifest 权限）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="page"
                    android:scheme="aifreegrip" />
            </intent-filter>

            <!-- 静态 App Shortcuts（主页/模拟/设置/关于），见 res/xml/shortcuts.xml -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 关于 = 独立子活动（standard 压栈：从设置入口/深链打开，返回键 关于→设置→主页） -->
        <activity
            android:name=".AboutActivity"
            android:exported="true"
            android:label="@string/about_title"
            android:theme="@style/Theme.AIFreegrip" />
    </application>

</manifest>
